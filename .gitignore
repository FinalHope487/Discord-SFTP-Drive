# Secrets. .env holds the bot token and the AES key; committing it once means
# rewriting history, and the token has to be rotated regardless.
.env
.env.*
!.env.example

# Docker secrets, mounted into the container at /run/secrets. `sftp_password`
# holds the password that unwraps the master key -- the whole reason it stopped
# being an environment variable is that fewer things should be able to read it,
# and a git history is one of those things.
secrets/

# SSH host key. Not a secret you can rotate cheaply -- replacing it makes every
# client report a host key mismatch, which is the same warning a real
# man-in-the-middle produces.
host_key
host_key.pub
keys/

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
settings.json
# The bare pattern above also caught this one, so both hooks shipped their code
# and not the registration that mounts them -- a clone got no enforcement and no
# error message either.
!.claude/settings.json

# Personal-eyes-only project notes, not meant for the tracked history.
BLUEPRINT.md
BLUEPRINT.md.bak
AGY_GEMINI_EVAL.md

# Internal working documents. `README.md` is the one public document and carries
# whatever of these an outside reader needs; keeping a second copy in the
# history means two things to keep correct and one of them silently rotting.
# `session-handoff.md` and `QUESTIONS.md` are addressed to whoever works on this
# next and mean nothing to anyone else.
GUIDE.md
BUILD.md
session-handoff.md
QUESTIONS.md

# The client. `dist/` is a build product -- it is mounted into the container
# rather than baked into the image, so it has to exist on disk, but rebuilding
# it is one command and committing it would put a minified copy of the whole
# frontend in every diff.
node_modules/
client/app/dist/

# Packaged desktop apps. ~90 MB each; `npm run dist` in client/shell rebuilds
# them, and a release belongs on a releases page rather than in the history.
dist-desktop/

# The standalone drive. `pyinstaller discord-drive.spec` rebuilds both; the
# spec file itself is committed, its output is not.
dist-standalone/
build-standalone/

# A drive's own metadata, if anyone runs the standalone build from a checkout
# with DISCORD_DRIVE_HOME pointed here. Committing one would publish the
# filenames, sizes and structure of somebody's whole drive -- the chunks are
# encrypted, this is what says how they fit together.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Developer mode: a second, throwaway stack (its own MongoDB volume, its own
# master key, ports 2223/8081) used to exercise the UI against real
# dependencies. Enabled when needed and deleted when not, so it stays out of
# the history entirely -- see .env.dev, which `.env.*` above already covers.
dev-stack/