{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Drive",
  "version": "0.1.0",
  "identifier": "dev.finalhope487.discorddrive",
  "build": {
    "frontendDist": "../electron/app"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Drive",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#161826",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "url": "http://127.0.0.1:8080"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
