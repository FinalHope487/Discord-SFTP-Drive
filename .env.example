# Copy to .env and fill in. Every REQUIRED value below has no default -- the
# server validates this set at startup and refuses to run if any is missing,
# reporting all problems at once.

# --- REQUIRED ---------------------------------------------------------------

DISCORD_BOT_TOKEN=your_discord_bot_token_here

# At least one of these two. DISCORD_USER_ID stores chunks in a DM with that
# user; DISCORD_CHANNEL_ID stores them in a channel. If both are set, the DM
# wins.
DISCORD_USER_ID=your_discord_user_id_here
DISCORD_CHANNEL_ID=

# SFTP login. There is no default account; an unset password is a startup
# error, not an open server.
#
# The password now does two jobs. Besides logging in, it wraps the key every
# stored file is encrypted with -- there is no AES_SECRET_KEY any more. The
# encryption key itself is random, generated on first start and kept in the
# database wrapped under this password, so nothing here is enough to decrypt
# anything on its own.
#
# Consequences worth knowing before you pick one:
#   * at least 12 bytes, enforced. Whoever obtains the database gets to guess
#     against it offline, which a login-only password never had to survive;
#   * losing it means losing every stored file. Back it up;
#   * changing it is cheap -- see SFTP_PASSWORD_OLD below. Stored data is not
#     re-encrypted, only the wrapped key is rewritten.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
SFTP_USER=
SFTP_PASSWORD=

# UNDER DOCKER COMPOSE, LEAVE SFTP_PASSWORD BLANK. Compose reads the password
# from `secrets/sftp_password` instead and mounts it at
# /run/secrets/sftp_password; the variable above is for running without Docker.
#
# The reason is what the password can do. An environment variable is handed out
# by `docker inspect`, printed by `docker compose config`, inherited by every
# child process, and readable at /proc/<pid>/environ -- and since this password
# derives the key that unwraps every stored file, that made reading the
# container's configuration equivalent to decrypting the data.
#
# Migrating an existing deployment, with the stack still running:
#   python scripts/adopt_password_secret.py
#   docker compose up -d --build
# It copies the password out of the running container rather than re-parsing
# `.env`, so nothing has to guess at Compose's quoting rules. Setting up fresh
# instead: write the password into `secrets/sftp_password` with no trailing
# newline beyond the one your editor adds.
#
# `secrets/` is gitignored. The path is overridable with SFTP_PASSWORD_SECRET
# if you keep secrets somewhere else on disk.
#
# Every secret below also accepts a `_FILE` variant naming a file to read it
# from -- DISCORD_BOT_TOKEN_FILE, MONGO_URI_FILE, SFTP_PASSWORD_OLD_FILE.
# Setting both a variable and its `_FILE` twin is refused rather than resolved
# by precedence. Exactly one trailing newline is stripped from the file, which
# is what `echo secret > file` and most editors add; a password that genuinely
# ends in a newline therefore cannot be stored this way.

# --- REQUIRED WHEN USING DOCKER COMPOSE -------------------------------------

# Compose creates the MongoDB root account from these on first start and
# builds MONGO_URI from them, so MONGO_URI itself is not set in that setup.
# Only read on the very first run: once the mongo_data volume is initialised,
# changing the password here does nothing. To actually change it, either
# rotate it inside mongosh or drop the volume (which deletes all metadata).
MONGO_ROOT_USERNAME=discorddrive
MONGO_ROOT_PASSWORD=

# --- OPTIONAL (defaults shown) ----------------------------------------------

# Running without Docker only. Under compose this is built from the two
# variables above.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=discord_sftp_vfs

# Host-side port. The container always listens on 2222 internally.
SFTP_PORT=2222

# Persist this across restarts, otherwise clients see a host key mismatch
# every time the container is recreated.
SFTP_HOST_KEY_PATH=host_key

# How many Discord requests may be in flight at once. Raising this does not
# make a large upload finish sooner -- the per-channel rate limit is the
# bound, and exceeding it just converts throughput into waiting. Lower it if
# the bot shares its rate-limit budget with other workloads.
DISCORD_MAX_CONCURRENCY=4

# --- CHANGING THE SFTP PASSWORD ---------------------------------------------

# Set this to the *previous* password, put the new one in SFTP_PASSWORD, and
# restart. The server opens the stored key with the old password, re-wraps it
# under the new one, and carries on -- no file is re-encrypted or re-uploaded.
# Remove it again afterwards; it is only read at startup and only when
# SFTP_PASSWORD alone does not work.
#
# Without it, changing SFTP_PASSWORD is a startup failure rather than silent
# data loss, which is the intended behaviour.
SFTP_PASSWORD_OLD=

# How the password is turned into the key that wraps the master key.
# "argon2id" (the default) or "pbkdf2-sha256". Argon2id costs memory as well
# as time, which is what makes guessing expensive on hardware built to guess
# in parallel; PBKDF2 is pure arithmetic and a GPU runs thousands at once.
#
# Each stored key records the function and the costs it was wrapped with, so
# changing anything below affects only keys wrapped from then on -- existing
# ones keep opening. Leaving both sets of costs here is fine; only the ones
# belonging to the selected KDF are used.
KDF=argon2id

# Argon2id costs. Memory is the parameter that matters most; OWASP's floor is
# 19456 KiB with a time cost of 2. Parallelism is recorded and has to be
# matched exactly on the way back, so leave it at 1 unless you have a reason.
# The cost is paid once per connection.
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=1

# Only used when KDF=pbkdf2-sha256. Higher is slower to guess and slower to
# log in.
PBKDF2_ITERATIONS=600000

# Whether startup may re-wrap an existing stored key onto the KDF above.
# Off by default. An existing deployment created before Argon2id keeps working
# on PBKDF2 either way -- the record says what made it -- and this only decides
# whether the server moves it across.
#
# Set to 1 for one restart, watch for the "Master key re-wrapped" line, then
# set it back. No stored file is touched: the master key is unchanged and only
# the wrapping around it is rewritten, and the new wrapping is verified to open
# before the old one is replaced.
KDF_UPGRADE=0

# ----------------------------------------------------------------- web UI
#
# The HTTP API runs inside the SFTP server's own process. That is not a
# convenience: handles coordinate through a dict that lives in the process, so
# a separate service against the same MongoDB would be the second replica this
# project forbids -- it would serve stale chunk layouts with no error and no
# log line.
WEB_ENABLED=1

# Which host address the container publishes the UI on. The default keeps it
# on the host's loopback: reachable from the machine running Docker, and from
# nowhere else. Read the "phones" section below before changing it.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# The address the server binds INSIDE the container, which is not the same
# question and protects nothing on its own. Under Docker it must be 0.0.0.0 or
# nothing outside the container could reach the UI at all -- the `127.0.0.1`
# in WEB_BIND above is the boundary, not this. Listed here because the code
# reads it and a setting nobody knows about is a setting nobody can reason
# about; compose overrides it, so changing it here has no effect on a compose
# deployment. It matters when running the server directly, without Docker,
# where the default below is the safe one.
# WEB_HOST=127.0.0.1

# How long a session may hold an unwrapped master key in memory.
#
# These are CEILINGS, not defaults. The UI may ask for a shorter session and
# gets it; asking for a longer one is clamped back to these. That asymmetry is
# the point -- a lifetime the browser can extend is a lifetime controlled by
# whoever stole the cookie.
#
# The idle timer restarts on every request. The absolute one does not, and
# that is what it is for: without it, a tab left open with any background
# polling keeps a key in memory until the process restarts.
WEB_SESSION_IDLE_SECONDS=600
WEB_SESSION_ABSOLUTE_SECONDS=7200

# A sign-in runs Argon2id twice at ARGON2_MEMORY_KIB each. asyncssh caps its
# own concurrent connections, so the SFTP path was bounded by accident; an
# HTTP endpoint is bounded by nothing. At the defaults above, 100 parallel
# sign-in attempts would be 6.4 GB of allocation from someone who never has to
# guess a password, and the process that dies takes the SFTP server with it.
#
# CONCURRENCY is how many run at once; QUEUE is how many may wait. Past the
# queue the answer is 503, because an unbounded queue is the same failure with
# extra steps.
WEB_LOGIN_CONCURRENCY=2
WEB_LOGIN_QUEUE=16

# Marks the session cookie Secure, so a browser will not send it over
# plaintext HTTP. Browsers treat http://localhost as a secure context, so this
# costs nothing on the default binding. Turning it off is a decision to let a
# cookie that stands for an unwrapped master key travel in the clear.
WEB_COOKIE_SECURE=1

# Where the built file manager lives, as the server sees it. Under compose this
# is set to /app/web and `client/app/dist` is mounted there read-only, so
# rebuilding the frontend is `npm run build` plus a refresh -- not an image
# rebuild, which would drop every live session and every unwrapped key with it.
#
# An empty or missing directory is deliberately not a startup error. The API and
# the SFTP surface do not depend on it, so refusing to boot over an unbuilt
# frontend would turn a cosmetic problem into an outage for SFTP clients too;
# instead `/` serves a page saying how to build it. See BUILD.md.
WEB_STATIC_DIR=web

# --- The trash --------------------------------------------------------------
#
# Deleting happens in two steps. `rm` over SFTP, and DELETE over HTTP, mark a
# node instead of destroying it; a sweep destroys it once this many days have
# passed, and only then are the Discord attachments released. Until that
# happens the bytes are still up there and still occupying whatever the bot
# can see -- that is the trade, not an oversight.
#
# 0 means "purge on the next sweep", which is a coherent setting and is what
# to use if you want the old behaviour back.
TRASH_RETENTION_DAYS=30

# How often the sweep runs, and how many items one pass may destroy.
#
# The batch cap is the one that matters. Purging costs a Discord call per
# attachment, so a month of accumulated deletions arriving at once is exactly
# the rate-limit stampede DISCORD_MAX_CONCURRENCY exists to prevent -- except
# unattended, at whatever hour the retention happens to expire. Whatever a
# pass leaves behind is taken by the next one.
TRASH_SWEEP_SECONDS=900
TRASH_SWEEP_BATCH=25

# The same sweep also collects overwrites that never finished.
#
# Replacing a file writes the new bytes into a node of its own and swaps it in
# at the very end, so an upload that dies part way through cannot destroy what
# it was replacing. A process killed before it can tidy up leaves that node
# behind, holding attachments nothing will reference again, and this is how
# long one may sit before the sweep takes it.
#
# Measured from the last committed chunk, not from the start of the upload, so
# a slow transfer of something enormous is never collected while it is still
# making progress. This only has to exceed the gap between two chunks. Being
# early destroys somebody's live upload; being late costs some Discord space.
INCOMING_MAX_AGE_HOURS=24

# Worth knowing: the sweep needs the master key, and this process does not
# hold one -- the key belongs to a session, not to the server. So the sweep
# runs over trees that have somebody signed in, and does nothing at all while
# nobody is. Retention therefore means "at least this long", never "exactly
# this long": something deleted 40 days ago on an account nobody has opened
# since is still there, and goes on the first sweep after the next sign-in.

# --- Reaching the UI from a phone -------------------------------------------
#
# Out of the box the UI is on the host's loopback only, so a phone cannot see
# it at all. That is deliberate: the session cookie is not a password, it is a
# reference to an already-unwrapped master key, and anything that can replay
# it can read every file. Three ways to fix that, in the order they are worth
# considering.
#
# 1. A private network (Tailscale, WireGuard, or your own VPN). RECOMMENDED.
#    Put the host and the phone on it, then:
#        WEB_BIND=<the host's address on that network>
#    Nothing else changes -- not WEB_COOKIE_SECURE, not the cookie flags --
#    because the traffic never crosses a network you do not control. The cost
#    is one piece of software on both devices, and it is the only option here
#    that adds no new way to get this wrong.
#
# 2. A reverse proxy with a real certificate (Caddy is two lines). Point a
#    hostname at the machine, let it terminate TLS, and forward to 8080:
#        WEB_BIND=127.0.0.1        # keep the app itself off the network
#    and publish the proxy instead. Everything stays as configured; the phone
#    gets a padlock rather than a warning. The cost is a public hostname, a
#    certificate to renew, and one more service in the compose file.
#
# 3. Plaintext on the LAN. NOT RECOMMENDED, and it needs two changes:
#        WEB_BIND=0.0.0.0
#        WEB_COOKIE_SECURE=0
#    The second one is the part to think about: it exists so you cannot end up
#    here by accident. Anything on that network -- a guest, a compromised
#    device, an untrusted access point -- can read the sign-in and replay the
#    cookie. If you take this route, shorten the session hard:
#        WEB_SESSION_IDLE_SECONDS=300
#        WEB_SESSION_ABSOLUTE_SECONDS=1800
#
# A self-signed certificate is deliberately not offered. It trains you to click
# through the warning that is supposed to mean something.
